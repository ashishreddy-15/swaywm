/**
 * Rofi Configuration
 * Theme: minimal monochrome + accent (see colors.md)
 * Font:  Maple Mono NF
 **/

configuration {
    modes:                      "drun,run,window,combi";
    combi-modes:                "drun,run";
    combi-hide-mode-prefix:     true;
    combi-display-format:       "{text}";
    font:                       "Maple Mono NF 11.75";
    show-icons:                 false;
    terminal:                   "foot";
    drun-display-format:        "{name}";
    disable-history:            false;
    hide-scrollbar:             true;
    fixed-num-lines:            false;

    display-drun:               "Search";
    display-run:                "Run";
    display-window:             "Windows";
    display-combi:              "Search";
}

* {
    bg:      #000000;
    surface: #111111;
    border:  #333333;
    muted:   #888888;
    fg:      #e6e6e6;
    accent:  #7aa2c8;
    background-color: transparent;
    text-color:       @fg;
}

window {
    background-color: @bg;
    border:           1px solid;
    border-color:     @border;
}

inputbar    { background-color: @surface; children: [prompt, entry]; spacing: 8px; }
prompt      { text-color: @accent; }
entry       { placeholder: ""; text-color: @fg; }
listview    { background-color: @bg; }
element selected.normal,
element selected.active,
element selected.urgent { background-color: @surface; text-color: @accent; }
element alternate.normal,
element normal.normal   { background-color: transparent; text-color: @fg; }
element normal.active   { text-color: @accent; }
element normal.urgent   { text-color: #e05555; }
message     { background-color: @surface; text-color: @muted; }

/* ── Sleek Wide Rectangle Dimensions ────────────────────────── */
window {
    width:                      640px;
    padding:                    6px;
}

inputbar {
    padding:                    4px 8px;
}

listview {
    lines:                      10;
    fixed-height:               false;
    dynamic:                    true;
    padding:                    4px 0px 0px 0px;
    spacing:                    1px;
    scrollbar:                  false;
}

element {
    padding:                    3px 8px;
}

element-text {
    vertical-align:             0.5;
    background-color:           inherit;
    text-color:                 inherit;
}
