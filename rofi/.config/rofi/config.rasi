/**
 * Rofi Configuration
 * Theme: Arc-Dark (official built-in theme, compact padding)
 * Font:  Maple Mono NF
 **/

configuration {
    modes:                      "drun,run,window,combi";
    combi-modes:                "drun,run";
    combi-hide-mode-prefix:     true;
    combi-display-format:       "{text}";
    font:                       "Maple Mono NF 11.75";
    show-icons:                 false;
    terminal:                   "foot";
    drun-display-format:        "{name}";
    disable-history:            false;
    hide-scrollbar:             true;
    fixed-num-lines:            false;

    display-drun:               "Search";
    display-run:                "Run";
    display-window:             "Windows";
    display-combi:              "Search";
}

@theme "Arc-Dark"

/* ── Sleek Wide Rectangle Dimensions ────────────────────────── */
window {
    width:                      640px;
    padding:                    6px;
}

inputbar {
    padding:                    4px 8px;
}

listview {
    lines:                      10;
    fixed-height:               false;
    dynamic:                    true;
    padding:                    4px 0px 0px 0px;
    spacing:                    1px;
    scrollbar:                  false;
}

element {
    padding:                    3px 8px;
}

element-text {
    vertical-align:             0.5;
    background-color:           inherit;
    text-color:                 inherit;
}
