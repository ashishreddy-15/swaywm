// -*- mode: jsonc -*-
// Module definitions shared by both bars (included from config.jsonc).
{
    "custom/separator#1": { "format": "|", "tooltip": false },
    "custom/separator#2": { "format": "|", "tooltip": false },
    "custom/separator#3": { "format": "|", "tooltip": false },
    "custom/separator#4": { "format": "|", "tooltip": false },

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{name}"
    },

    "sway/mode": {
        "format": "<span style=\"italic\">[{}]</span>"
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "[AWAKE]",
            "deactivated": "IDLE"
        },
        "tooltip": true,
        "tooltip-format-activated": "Idle inhibitor: Active",
        "tooltip-format-deactivated": "Idle inhibitor: Inactive"
    },

    "pulseaudio": {
        "scroll-step": 5,
        "format": "VOL {volume}%",
        "format-bluetooth": "VOL {volume}% [BT]",
        "format-bluetooth-muted": "VOL [MUTED]",
        "format-muted": "VOL [MUTED]",
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "tooltip-format": "{desc} ({volume}%)"
    },

    "battery": {
        "states": {
            "warning": 25,
            "critical": 15
        },
        "format": "BAT {capacity}%",
        "format-charging": "BAT {capacity}% [CHR]",
        // [AC] = plugged in but holding at the charge limit (the usual state);
        // dimmed so [CHR] (actually charging) stands out. Alpha instead of a
        // hex keeps the palette in style.css only.
        "format-plugged": "BAT {capacity}% <span alpha='60%'>[AC]</span>",
        "format-alt": "BAT {time}",
        "tooltip-format": "{timeTo}, {capacity}%\nPower draw: {power:0.2f}W"
    },

    // Click cycles power-saver → balanced → performance (built into the module)
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "[DEF]",
            "performance": "[PERF]",
            "balanced": "[BAL]",
            "power-saver": "[SAV]"
        }
    },

    // Minute resolution; click toggles to the long date format
    "clock": {
        "interval": 60,
        "format": "{:%Y-%m-%d %H:%M}",
        "format-alt": "{:%a %b %d  %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "on-scroll": 1
        }
    }
}
