// -*- mode: jsonc -*-
// Clean, minimal i3bar-style Waybar configuration with per-display sizing.
// Module settings live in modules.jsonc; each bar below only sets what
// differs between the two screens (height, tray size).
[
    // ── External Displays (HDMI, DisplayPort, USB-C) ───────────
    {
        "include": ["~/.config/waybar/modules.jsonc"],
        "output": "!eDP-1",
        "name": "external",
        "layer": "bottom",
        "position": "bottom",
        "height": 24,
        "spacing": 0,

        "modules-left": ["sway/workspaces", "sway/mode"],
        "modules-center": [],
        "modules-right": [
            "idle_inhibitor", "custom/separator#1",
            "pulseaudio", "custom/separator#2",
            "battery", "power-profiles-daemon", "custom/separator#3",
            "clock", "custom/separator#4",
            "tray"
        ],

        "tray": { "icon-size": 15, "spacing": 6 }
    },

    // ── Laptop Display (eDP-1) ──────────────────────────────────
    {
        "include": ["~/.config/waybar/modules.jsonc"],
        "output": "eDP-1",
        "name": "laptop",
        "layer": "bottom",
        "position": "bottom",
        "height": 28,
        "spacing": 0,

        "modules-left": ["sway/workspaces", "sway/mode"],
        "modules-center": [],
        "modules-right": [
            "idle_inhibitor", "custom/separator#1",
            "pulseaudio", "custom/separator#2",
            "battery", "power-profiles-daemon", "custom/separator#3",
            "clock", "custom/separator#4",
            "tray"
        ],

        "tray": { "icon-size": 17, "spacing": 7 }
    }
]
