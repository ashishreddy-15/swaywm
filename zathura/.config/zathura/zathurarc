# zathura — keyboard-driven PDF viewer (palette: see colors.md)
set font                    "Maple Mono NF 10"
set selection-clipboard     clipboard
set adjust-open             width
set guioptions              "s"
set recolor                 false

set default-bg              "#000000"
set default-fg              "#e6e6e6"
set statusbar-bg            "#111111"
set statusbar-fg            "#888888"
set inputbar-bg             "#111111"
set inputbar-fg             "#e6e6e6"
set notification-bg         "#111111"
set notification-fg         "#e6e6e6"
set notification-error-bg   "#111111"
set notification-error-fg   "#e05555"
set notification-warning-bg "#111111"
set notification-warning-fg "#e0a030"
set completion-bg           "#111111"
set completion-fg           "#888888"
set completion-group-bg     "#000000"
set completion-group-fg     "#555555"
set completion-highlight-bg "#222222"
set completion-highlight-fg "#7aa2c8"
set index-bg                "#000000"
set index-fg                "#e6e6e6"
set index-active-bg         "#222222"
set index-active-fg         "#7aa2c8"
set highlight-color         "rgba(122,162,200,0.35)"
set highlight-active-color  "rgba(122,162,200,0.65)"

# Ctrl+r toggles dark-page mode using these colors
set recolor-lightcolor      "#000000"
set recolor-darkcolor       "#e6e6e6"
set recolor-keephue         true
