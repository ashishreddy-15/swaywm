# zathura — keyboard-driven PDF viewer (palette: see colors.md)
set font                    "Maple Mono NF 10"
set selection-clipboard     clipboard
set adjust-open             width
set guioptions              "s"
set recolor                 false

set default-bg              "#0f110d"
set default-fg              "#e6e8e1"
set statusbar-bg            "#161a14"
set statusbar-fg            "#8c9384"
set inputbar-bg             "#161a14"
set inputbar-fg             "#e6e8e1"
set notification-bg         "#161a14"
set notification-fg         "#e6e8e1"
set notification-error-bg   "#161a14"
set notification-error-fg   "#e05555"
set notification-warning-bg "#161a14"
set notification-warning-fg "#db892d"
set completion-bg           "#161a14"
set completion-fg           "#8c9384"
set completion-group-bg     "#0f110d"
set completion-group-fg     "#5a6152"
set completion-highlight-bg "#222820"
set completion-highlight-fg "#6fa3b8"
set index-bg                "#0f110d"
set index-fg                "#e6e8e1"
set index-active-bg         "#222820"
set index-active-fg         "#6fa3b8"
set highlight-color         "rgba(122,162,200,0.35)"
set highlight-active-color  "rgba(122,162,200,0.65)"

# Ctrl+r toggles dark-page mode using these colors
set recolor-lightcolor      "#0f110d"
set recolor-darkcolor       "#e6e8e1"
set recolor-keephue         true
