# ============================================================
# Dunst Configuration
# man 5 dunst
# ============================================================

[global]
    ### Display & Monitor ###
    # Display notifications on the monitor with mouse focus
    follow = mouse
    # Fallback monitor if follow is not set or unavailable
    monitor = 0

    ### Geometry ###
    # Fixed width, centred over the island (narrower than it, so a one-line
    # message doesn't become a wide slab)
    width = 480
    # Dynamic height up to 300px
    height = (0, 300)
    # Stack upward from just above the island bar (bottom-centre). dunst
    # already starts above waybar's reserved row, so this is only the gap.
    # Newest sits nearest the island.
    origin = bottom-center
    offset = (0, 6)
    # Per-display scaling (0 = auto-detect)
    scale = 0
    # Maximum number of visible notifications
    notification_limit = 6
    # Indicate hidden notifications count
    indicate_hidden = yes

    ### Spacing & Borders ###
    # Vertical padding inside notification
    padding = 6
    # Horizontal padding inside notification
    horizontal_padding = 12
    # Spacing between icon and text
    text_icon_padding = 8
    # Border width around notifications
    frame_width = 1
    # Default border frame color (border; accent is for focus only)
    frame_color = "#2e342a"
    # Gap between notifications; each one is drawn as its own box,
    # so no separator settings are needed
    gap_size = 6
    # Square, like the island and windows
    corner_radius = 0

    ### Progress Bar ###
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 0

    ### Typography ###
    # Font matches the system monospace font
    font = Maple Mono NF 10
    line_height = 0
    markup = full
    # %s = summary (title), %b = body
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    ### Icons ###
    enable_recursive_icon_lookup = true
    icon_theme = "Adwaita, hicolor"
    icon_position = left
    min_icon_size = 16
    max_icon_size = 20
    icon_corner_radius = 0

    ### History ###
    sticky_history = yes
    history_length = 20

    ### Wayland Settings ###
    layer = top
    force_xwayland = false

    ### Mouse Actions ###
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

# ── Urgency Levels ──────────────────────────────────────────

[urgency_low]
    # Palette: see colors.md
    background = "#161a14"
    foreground = "#8c9384"
    frame_color = "#2e342a"
    highlight = "#6fa3b8"
    timeout = 5
    default_icon = dialog-information

[urgency_normal]
    # Palette: see colors.md
    background = "#161a14"
    foreground = "#e6e8e1"
    # Plain border; accent is reserved for focus (see colors.md)
    frame_color = "#2e342a"
    highlight = "#6fa3b8"
    timeout = 8
    default_icon = dialog-information

[urgency_critical]
    # Red frame for critical
    background = "#161a14"
    foreground = "#e6e8e1"
    frame_color = "#e05555"
    highlight = "#e05555"
    timeout = 0
    default_icon = dialog-warning

# ── Compact status popups ───────────────────────────────────
# Short-lived status messages from sway/scripts (brightness, DND,
# nightlight, calc): one line, no icon, kept out of history.

[osd_brightness]
    appname = brightness
    format = "<b>%s</b>  <span foreground='#8c9384'>%b</span>"
    icon_position = off
    history_ignore = yes

[osd_dnd]
    appname = dnd
    format = "<b>%s</b>  <span foreground='#8c9384'>%b</span>"
    icon_position = off
    history_ignore = yes

[osd_nightlight]
    appname = nightlight
    format = "<b>%s</b>  <span foreground='#8c9384'>%b</span>"
    icon_position = off
    history_ignore = yes

# Volume popups come from Fedora's /usr/libexec/sway/volume-helper, which
# sends no icon (dunst would otherwise fall back to default_icon).
[osd_volume]
    appname = sway
    stack_tag = volume
    format = "<b>%s</b>"
    icon_position = off
    history_ignore = yes

[osd_calc]
    appname = calc
    format = "<b>%s</b>  <span foreground='#8c9384'>%b</span>"
    icon_position = off
    history_ignore = yes
