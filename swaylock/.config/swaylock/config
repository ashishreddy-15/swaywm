# Swaylock configuration
# Overrides /etc/swaylock/config
# man swaylock for all options

# Wallpaper behind the lock ring (same image as the desktop); the colour is
# the fallback if the image can't be loaded
image=~/.config/sway/wallpaper.jpg
scaling=fill
color=0f110d
inside-color=161a14
inside-clear-color=161a14
inside-ver-color=161a14
inside-wrong-color=161a14
line-color=2e342a
line-clear-color=8c9384
line-ver-color=6fa3b8
line-wrong-color=e05555
ring-color=2e342a
ring-clear-color=8c9384
ring-ver-color=6fa3b8
ring-wrong-color=e05555
key-hl-color=6fa3b8
bs-hl-color=e05555
text-color=e6e8e1
text-clear-color=e6e8e1
text-ver-color=e6e8e1
text-wrong-color=e05555
separator-color=00000000
indicator-thickness=4
indicator-radius=70

# Show indicator on blank screen too (not only on keypress)
show-failed-attempts
indicator-idle-visible
