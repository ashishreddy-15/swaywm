# ── Kanshi Display Profiles ──────────────────────────────────
# Handles HDMI connect / disconnect events

# Dual monitor setup (Laptop on left, Samsung 27" at 100Hz on right)
profile dual {
    output eDP-1 mode 1920x1200 position 0,0
    output HDMI-A-1 mode 2560x1440@100Hz position 1920,0
    exec ~/.config/sway/scripts/migrate-workspaces.sh dual
}

# Solo / Laptop screen only (when HDMI cable is unplugged)
profile solo {
    output eDP-1 mode 1920x1200 position 0,0
    exec ~/.config/sway/scripts/migrate-workspaces.sh solo
}
