# ── Kanshi Display Profiles ──────────────────────────────────
# Applied automatically on monitor connect/disconnect.
# The first profile whose outputs match the connected screens wins.
#
# Workspaces follow the outputs on their own (see the `workspace N output`
# rules in the sway config). After a profile is applied, lid-handler.sh
# turns the laptop panel off again if the lid is closed.
#
# Keep positions in sync with the `output` lines in ~/.config/sway/config.

# Laptop (left, bottom-aligned) + Samsung 27" @ 100Hz (right), any port
profile dual {
    output eDP-1 enable mode 1920x1200 position 0,240
    output "Samsung Electric Company LS27F61x H4CL500159" enable mode 2560x1440@100Hz position 1920,0
    exec ~/.config/sway/scripts/lid-handler.sh
}

# Laptop + any other external monitor (preferred mode, to the right)
profile external {
    output eDP-1 enable mode 1920x1200 position 0,0
    output * enable position 1920,0
    exec ~/.config/sway/scripts/lid-handler.sh
}

# Laptop only
profile solo {
    output eDP-1 enable mode 1920x1200 position 0,0
}
