# ============================================================
# Sway Configuration
# man 5 sway  |  man 5 sway-input  |  man 5 sway-output
# ============================================================

# ── Variables ───────────────────────────────────────────────
# Logo key (Mod4 = Super, Mod1 = Alt)
set $mod   Mod4
set $left  h
set $down  j
set $up    k
set $right l

set $term        foot
set $rofi_toggle ~/.config/sway/scripts/rofi-toggle.sh
set $menu        $rofi_toggle launcher

# Outputs: the laptop panel, and every port an external monitor can use
# (HDMI or USB-C/DP), so workspace rules work with any external screen.
set $laptop   eDP-1
set $external HDMI-A-1 DP-1 DP-2 DP-3 DP-4
set $samsung  "Samsung Electric Company LS27F61x H4CL500159"

# ── Appearance ──────────────────────────────────────────────
font pango:Maple Mono NF 10

# ── Output ──────────────────────────────────────────────────
# Physical layout: [laptop eDP-1] [Samsung 27"]
#   Laptop screen is to the LEFT; turn your head left to see it.
#   eDP-1    x=0..1920,    y=240..1440  (bottom-aligned with the Samsung)
#   Samsung  x=1920..4480, y=0..1440
# The Samsung is matched by make/model/serial, not by port, so it works on
# HDMI or USB-C. Keep these in sync with ~/.config/kanshi/config: kanshi
# handles hotplug, these lines keep the layout right after `reload`.
# `subpixel rgb`: both panels report "unknown", which makes foot and other
# clients fall back to grayscale font smoothing (softer text, esp. at ~109 PPI).

output $laptop  resolution 1920x1200        position 0,240 subpixel rgb
output $samsung resolution 2560x1440@100Hz  position 1920,0 subpixel rgb

# No wallpaper — solid black background on all outputs
output * bg #000000 solid_color

# ── Window colors (palette: see colors.md) ──────────────────
# The split indicator (where the next window opens) is fg, so it is
# distinct from the accent focus border.
#                       border   background text     indicator child_border
client.focused          #7aa2c8  #111111    #e6e6e6  #e6e6e6   #7aa2c8
client.focused_inactive #333333  #111111    #888888  #333333   #333333
client.unfocused        #333333  #000000    #888888  #333333   #333333
client.urgent           #e05555  #111111    #e6e6e6  #e05555   #e05555
client.placeholder      #333333  #000000    #888888  #333333   #333333
client.background       #000000

# ── Window look: flat, no titlebars, small gaps ─────────────
default_border pixel 2
default_floating_border pixel 2

# Small gaps between windows; a lone window fills the screen with no
# gap or border (smart_gaps + smart_borders)
gaps inner 4
smart_gaps on
smart_borders on

# Title bars (only shown in tabbed/stacked layouts): roomier, centred,
# with a 1px edge that lines up with window borders
titlebar_padding 8 3
titlebar_border_thickness 1
title_align center

# Cursor: same theme and size as GTK apps (gsettings), so the pointer
# does not change between sway, Wayland and Xwayland windows
seat seat0 xcursor_theme Adwaita 24

# ── Clamshell Mode (Laptop Lid Switch) ──────────────────────
# --reload re-runs the binding on `reload`, so the panel stays off if the
# lid is closed. kanshi also runs lid-handler.sh after every hotplug.
bindswitch --reload --locked lid:on  exec ~/.config/sway/scripts/lid-handler.sh close
bindswitch --reload --locked lid:off exec ~/.config/sway/scripts/lid-handler.sh open

# ── Input ───────────────────────────────────────────────────
# Faster key repeat; Caps Lock acts as Escape
input "type:keyboard" {
    repeat_delay 250
    repeat_rate 40
    xkb_options caps:escape
}

# Synaptics touchpad (ThinkPad)
input "type:touchpad" {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
    scroll_method two_finger
}

# ── Autostart ────────────────────────────────────────────────
# Low-battery warnings (15% and 5%)
exec ~/.config/sway/scripts/battery-notify.sh

# Clipboard history daemon. Entries copied from password managers
# (marked sensitive) are not stored.
exec wl-paste --watch cliphist -max-items 200 store
exec wl-paste --type image --watch cliphist -max-items 200 store

# ── Key bindings: Basics ─────────────────────────────────────
bindsym $mod+Return       exec $term
bindsym $mod+q            kill
bindsym $mod+d            exec $menu
bindsym $mod+x            exec $rofi_toggle power
bindsym $mod+v            exec $rofi_toggle clipboard
bindsym $mod+Ctrl+v       exec cliphist wipe && notify-send -u low "Clipboard" "History cleared"
bindsym $mod+Shift+r      reload
bindsym $mod+Shift+Escape exec loginctl lock-session

# Drag/resize floating windows with $mod + mouse buttons
floating_modifier $mod normal

# Pressing the current workspace's key again does nothing (no back-and-forth)
workspace_auto_back_and_forth no

# ── Key bindings: Focus ──────────────────────────────────────
bindsym $mod+$left   focus left
bindsym $mod+$down   focus down
bindsym $mod+$up     focus up
bindsym $mod+$right  focus right
bindsym $mod+Left    focus left
bindsym $mod+Down    focus down
bindsym $mod+Up      focus up
bindsym $mod+Right   focus right

# ── Key bindings: Move window ────────────────────────────────
bindsym $mod+Shift+$left   move left
bindsym $mod+Shift+$down   move down
bindsym $mod+Shift+$up     move up
bindsym $mod+Shift+$right  move right
bindsym $mod+Shift+Left    move left
bindsym $mod+Shift+Down    move down
bindsym $mod+Shift+Up      move up
bindsym $mod+Shift+Right   move right

# ── Workspace output assignments ─────────────────────────────
# 1-5  → external monitor preferred, laptop fallback
# 6-10 → laptop preferred, external fallback
# Sway uses these lists to move workspaces automatically: when an output is
# disabled/unplugged its workspaces go to the fallback, and when the
# preferred output comes back they return to it. No scripts needed.
workspace 1  output $external $laptop
workspace 2  output $external $laptop
workspace 3  output $external $laptop
workspace 4  output $external $laptop
workspace 5  output $external $laptop
workspace 6  output $laptop $external
workspace 7  output $laptop $external
workspace 8  output $laptop $external
workspace 9  output $laptop $external
workspace 10 output $laptop $external

# ── Key bindings: Workspaces ─────────────────────────────────
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Jump focus between monitors / send the current workspace to the other one
bindsym $mod+Tab       focus output right
bindsym $mod+Shift+Tab move workspace to output right

# ── Key bindings: Layout ─────────────────────────────────────
bindsym $mod+b       splith
bindsym $mod+Shift+v splitv
bindsym $mod+s       layout stacking
bindsym $mod+w       layout tabbed
bindsym $mod+e       layout toggle split
bindsym $mod+f       fullscreen

bindsym $mod+Shift+space floating toggle
bindsym $mod+space       focus mode_toggle
bindsym $mod+a           focus parent

# ── Key bindings: Scratchpad ─────────────────────────────────
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus       scratchpad show

# ── Resize mode ──────────────────────────────────────────────
mode "resize" {
    bindsym $left   resize shrink width  10px
    bindsym $down   resize grow   height 10px
    bindsym $up     resize shrink height 10px
    bindsym $right  resize grow   width  10px
    bindsym Left    resize shrink width  10px
    bindsym Down    resize grow   height 10px
    bindsym Up      resize shrink height 10px
    bindsym Right   resize grow   width  10px
    bindsym Return  mode "default"
    bindsym Escape  mode "default"
}
bindsym $mod+r mode "resize"

# ── Drop-in configs (layered: system → /etc → user) ──────────
include '$(/usr/libexec/sway/layered-include "/usr/share/sway/config.d/*.conf" "/etc/sway/config.d/*.conf" "${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/*.conf")'
